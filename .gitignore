# Hugo output
public/
resources/
.hugo_build.lock

# Generated matplotlib plots (regenerated by run_plots.py on every build)
static/plots/*/
!static/plots/.gitkeep

# Wiki derived index (rebuilt on every validate)
scripts/wiki.db

# Python
__pycache__/
*.pyc
.venv/
dist/
*.egg-info/

# uv
.uv/

# Style reference app build artifacts and secrets
styles/.env.local
styles/.env.*.local
styles/dist/

# Style reference app — ignore all images (large binary concept art, screenshots)
styles/concept-art/
styles/concept-art2/
styles/*.png
styles/*.jpg
styles/*.jpeg
styles/*.webp
styles/*.gif
styles/src/**/*.png
styles/src/**/*.jpg
styles/src/**/*.webp
styles/node_modules/

# Editor
.DS_Store
*.swp
*.swo
Thumbs.db

# Scratch directory for unsorted authoring material
raw-sort-me/

# Playwright UI test artifacts
tests/node_modules/
tests/test-results/
tests/playwright-report/

# this file contains the secret Google API API_KEY
# NEVER git commit this file
api_key.sh
